// Dukaan Express — normalized PostgreSQL schema.
// Money is always stored as integer paise. Rates are stored in basis points (1% = 100 bps).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SHOP_OWNER
  CUSTOMER
  DEALER
  RIDER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  SHOP_PENDING
  SHOP_ACCEPTED
  SHOP_REJECTED
  PREPARING
  READY_FOR_PACKING
  PACKED
  SHIPMENT_CREATING
  SHIPMENT_CREATED
  COURIER_ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  DELIVERY_FAILED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  COD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShipmentStatus {
  PENDING
  CREATING
  CREATED
  COURIER_ASSIGNED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RTO
  CANCELLED
  EXCEPTION
}

/// How a shop's orders reach customers.
enum DeliveryMode {
  OWN // the shop's own staff delivers; the shop keeps the delivery fee
  RIDER // a Dukaan Express rider picks up and delivers; the rider earns the delivery fee
  SELF_BOOKED // the shop books a delivery app (Rapido, Ola, Porter…) itself and pays for it; the customer pays no delivery fee
}

/// Rider verification: self-signed-up riders upload documents; their dealer or an admin approves.
enum RiderKycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum BadgeKind {
  SHOP
  RIDER
}

enum WalletEntryType {
  DELIVERY_EARNING // + delivery fee for a completed delivery
  COD_COLLECTED // − cash the rider collected from a cash-on-delivery customer (rider keeps it)
  WITHDRAWAL // − money set aside for a withdrawal request
  WITHDRAWAL_REVERSAL // + returned when a withdrawal is declined or cancelled
  ADJUSTMENT // ± manual correction by the admin
}

enum RefundStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum SettlementStatus {
  DEALER_REVIEW // shop has a dealer: waits for the dealer to check and approve before reaching the admin
  PENDING // requested by the shop owner (or created by admin), awaiting transfer
  PROCESSING
  PAID
  REJECTED // admin declined; its orders return to the available balance
  CANCELLED // owner withdrew the request; its orders return to the available balance
}

enum CouponType {
  FLAT
  PERCENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ModificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ───────────────────────────── Identity & RBAC ─────────────────────────────

model Role {
  key         UserRole @id
  name        String
  description String?
  permissions String[]
}

model User {
  id              String     @id @default(cuid())
  role            UserRole
  name            String?
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)
  sessionVersion  Int        @default(0)
  lastLoginAt     DateTime?
  /// Temporary password (AES-encrypted) kept only until the welcome email goes out, e.g. while a shop owner's agreement is unsigned.
  welcomeSecret   String?
  welcomeSentAt   DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  customer      Customer?
  shopOwner     ShopOwner?
  dealer        Dealer?
  rider         Rider?
  notifications Notification[]
  deviceTokens  DeviceToken[]
  auditLogs     AuditLog[]

  @@index([role, status])
}

model Otp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("LOGIN")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// One-time codes sent by email: SIGNUP (verify the address before creating an account) and RESET (forgot password).
model EmailCode {
  id         String    @id @default(cuid())
  email      String
  purpose    String // SIGNUP | RESET
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose, createdAt])
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses   CustomerAddress[]
  cart        Cart?
  orders      Order[]
  reviews     Review[]
  tickets     SupportTicket[]
  redemptions CouponRedemption[]
}

model ShopOwner {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shops Shop[]
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("web")
  createdAt DateTime @default(now())

  @@index([userId])
}

// ───────────────────────────── Shops ─────────────────────────────

model Shop {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  description      String?
  ownerId          String?
  owner            ShopOwner?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  categoryId       String?
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contactPhone     String
  contactEmail     String?
  gstNumber        String?
  logoUrl          String?
  coverUrl         String?
  approvalStatus   ApprovalStatus @default(PENDING)
  rejectionReason  String?
  isActive         Boolean        @default(false)
  acceptingOrders  Boolean        @default(true)
  deliveryRadiusKm Float          @default(5)
  commissionBps    Int? // null → platform default
  avgPrepMinutes   Int            @default(10)
  rating           Float          @default(0)
  ratingCount      Int            @default(0)
  deliveryMode     DeliveryMode   @default(RIDER)
  dealerId         String? // regional dealer who onboarded / manages this shop
  dealer           Dealer?        @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  agreementAcceptedAt DateTime? // seller agreement signed (email OTP); the shop can't go live before
  /// Wholesale (B2B): this shop sells in bulk to other shops.
  sellsBulk         Boolean @default(false)
  bulkMinOrder      Int     @default(0) // paise; minimum bulk order value
  bulkDelivers      Boolean @default(true) // seller delivers bulk orders
  bulkDeliveryFee   Int     @default(0) // paise; flat fee for seller delivery
  bulkPickup        Boolean @default(true) // buyer may collect from the shop
  bulkPayOnDelivery Boolean @default(true) // buyer may pay the seller on delivery / pickup
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  address     ShopAddress?
  hours       ShopOperatingHours[]
  images      ShopImage[]
  inventory   ShopInventory[]
  orders      Order[]
  commissions Commission[]
  settlements ShopSettlement[]
  bankAccount ShopBankAccount?
  badges      Badge[]
  reviews     Review[]
  coupons     Coupon[]
  cartItems   CartItem[]
  agreements  ShopAgreement[]
  bulkPurchases BulkOrder[] @relation("BulkBuyer")
  bulkSales     BulkOrder[] @relation("BulkSeller")

  @@index([approvalStatus, isActive])
  @@index([ownerId])
  @@index([dealerId])
}

model ShopAddress {
  id        String  @id @default(cuid())
  shopId    String  @unique
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  latitude  Float
  longitude Float

  @@index([pincode])
  @@index([latitude, longitude])
}

model ShopOperatingHours {
  id        String  @id @default(cuid())
  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday
  openTime  String // "HH:mm"
  closeTime String
  isClosed  Boolean @default(false)

  @@unique([shopId, dayOfWeek])
}

model ShopImage {
  id        String @id @default(cuid())
  shopId    String
  shop      Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int    @default(0)
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  imageUrl    String?
  description String?
  taxRateBps  Int? // GST for the category; null → default
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  subcategories Subcategory[]
  products      Product[]
  shops         Shop[]
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  imageUrl   String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products Product[]

  @@unique([categoryId, slug])
}

model ProductAttribute {
  id        String   @id @default(cuid())
  name      String   @unique
  values    String[]
  createdAt DateTime @default(now())
}

/// Global product master — independent of any shop's price or stock.
model Product {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  brand           String?
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  subcategoryId   String?
  subcategory     Subcategory?   @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  sku             String?        @unique
  barcode         String?
  unit            String         @default("pcs") // pcs | g | kg | ml | l | pack
  unitValue       Float? // e.g. 500 (g)
  weightGrams     Int            @default(500)
  lengthCm        Float          @default(10)
  breadthCm       Float          @default(10)
  heightCm        Float          @default(10)
  attributes      Json?
  approvalStatus  ApprovalStatus @default(APPROVED)
  isActive        Boolean        @default(true)
  createdByShopId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  images    ProductImage[]
  variants  ProductVariant[]
  inventory ShopInventory[]

  @@index([categoryId, subcategoryId])
  @@index([name])
  @@index([approvalStatus, isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String // "500 g", "1 kg", "Large"
  sku         String?  @unique
  unitValue   Float?
  weightGrams Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  inventory ShopInventory[]

  @@unique([productId, name])
}

/// Shop-specific price and stock for a product (and optional variant).
model ShopInventory {
  id                String          @id @default(cuid())
  shopId            String
  shop              Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantKey        String          @default("") // variantId or "" — makes the unique key NULL-safe
  shopSku           String?
  mrp               Int
  sellingPrice      Int
  stock             Int             @default(0)
  lowStockThreshold Int             @default(5)
  maxPerOrder       Int             @default(10)
  isAvailable       Boolean         @default(true)
  bulkPrice         Int? // paise per unit for bulk buyers; null = not sold in bulk
  bulkMinQty        Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  cartItems  CartItem[]
  orderItems OrderItem[]
  bulkItems  BulkOrderItem[]

  @@unique([shopId, productId, variantKey])
  @@index([productId])
  @@index([shopId, isAvailable])
}

// ───────────────────────────── Customers, cart ─────────────────────────────

model CustomerAddress {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String    @default("Home")
  name       String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  pincode    String
  latitude   Float
  longitude  Float
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([customerId])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
}

/// Lines carry shopId so a future version can split one checkout into per-shop orders.
model CartItem {
  id          String        @id @default(cuid())
  cartId      String
  cart        Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   ShopInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  shopId      String
  shop        Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  quantity    Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([cartId, inventoryId])
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  description    String?
  type           CouponType
  value          Int // paise for FLAT, bps for PERCENT
  maxDiscount    Int?
  minOrderAmount Int        @default(0)
  usageLimit     Int?
  perUserLimit   Int        @default(1)
  usedCount      Int        @default(0)
  firstOrderOnly Boolean    @default(false)
  shopId         String?
  shop           Shop?      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  validFrom      DateTime   @default(now())
  validTo        DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Int
  createdAt  DateTime @default(now())

  @@index([couponId, customerId])
}

// ───────────────────────────── Orders ─────────────────────────────

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  checkoutGroupId  String // one checkout → many orders (multi-shop ready)
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id])
  shopId           String
  shop             Shop          @relation(fields: [shopId], references: [id])
  status           OrderStatus   @default(CREATED)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  addressSnapshot  Json
  deliveryLat      Float
  deliveryLng      Float
  deliveryPincode  String
  contactName      String
  contactPhone     String
  itemsMrpTotal    Int
  subtotal         Int // Σ selling price × qty
  itemDiscount     Int // Σ (mrp − selling) × qty
  couponDiscount   Int           @default(0)
  deliveryFee      Int           @default(0)
  taxAmount        Int           @default(0)
  taxInclusive     Boolean       @default(true)
  total            Int
  couponId         String?
  coupon           Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode       String?
  commissionBps    Int
  commissionAmount Int
  shopEarning      Int
  distanceKm       Float
  etaMinutes       Int
  notes            String?
  rejectionReason  String?
  cancelReason     String?
  cancelledBy      String?
  placedAt         DateTime      @default(now())
  acceptedAt       DateTime?
  packedAt         DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items         OrderItem[]
  payments      Payment[]
  shipment      Shipment?
  statusHistory OrderStatusHistory[]
  refunds       Refund[]
  review        Review?
  tickets       SupportTicket[]
  commission    Commission?
  redemption    CouponRedemption?
  modifications OrderModification[]

  @@index([shopId, status])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([checkoutGroupId])
}

/// Snapshot of what was bought — immune to later catalog price edits.
model OrderItem {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   ShopInventory @relation(fields: [inventoryId], references: [id])
  productId   String
  variantId   String?
  productName String
  variantName String?
  imageUrl    String?
  unitLabel   String?
  quantity    Int
  mrp         Int
  unitPrice   Int
  lineTotal   Int
  taxRateBps  Int           @default(0)
  taxAmount   Int           @default(0)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  changedById   String?
  changedByRole String // SUPER_ADMIN | SHOP_OWNER | CUSTOMER | SYSTEM
  remarks       String?
  createdAt     DateTime     @default(now())

  @@index([orderId, createdAt])
}

/// Authorized post-confirmation change (e.g. item out of stock). Requires admin approval.
model OrderModification {
  id            String             @id @default(cuid())
  orderId       String
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedById String
  reason        String
  changes       Json // [{ orderItemId, newQuantity }]
  status        ModificationStatus @default(PENDING)
  reviewedById  String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())

  @@index([orderId])
  @@index([status])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String // CASHFREE | CASHFREE_MOCK | COD
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Int
  currency          String        @default("INR")
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  providerMethod    String? // payment group as reported by Cashfree (upi, credit_card, net_banking, …)
  failureReason     String?
  raw               Json?
  capturedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  refunds Refund[]

  @@index([orderId])
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId        String?
  payment          Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount           Int
  reason           String
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @unique
  initiatedById    String?
  failureReason    String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orderId])
  @@index([status])
}

// ───────────────────────────── Delivery ─────────────────────────────

/// One delivery per order: by the shop's own staff (OWN) or a Dukaan Express rider (RIDER).
/// status: CREATED = looking for a rider, COURIER_ASSIGNED = rider accepted, OUT_FOR_DELIVERY, DELIVERED,
/// FAILED_ATTEMPT, CANCELLED. PENDING = own delivery not yet dispatched.
model Shipment {
  id                  String         @id @default(cuid())
  orderId             String         @unique
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mode                DeliveryMode   @default(RIDER)
  status              ShipmentStatus @default(PENDING)
  riderId             String?
  rider               Rider?         @relation(fields: [riderId], references: [id], onDelete: SetNull)
  riderFee            Int            @default(0) // what the rider earns for this delivery (paise)
  codAmount           Int            @default(0) // cash to collect from the customer (paise)
  deliveryCode        String         @default("") // 4-digit handover code the customer tells the rider
  searchStartedAt     DateTime?
  noRiderAlertedAt    DateTime?
  assignedAt          DateTime?
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  attempts            Int            @default(0) // how many riders accepted it (re-assignments)
  failedDeliveryCount Int            @default(0)
  lastError           String?
  lastErrorAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  events ShipmentTrackingEvent[]

  @@index([status, riderId])
  @@index([riderId, status])
}

model ShipmentTrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  rawStatus   String?
  location    String?
  description String?
  source      String // WEBHOOK | POLL | SYSTEM
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([shipmentId, occurredAt])
}

// ───────────────────────────── Money ─────────────────────────────

model Commission {
  id             String          @id @default(cuid())
  orderId        String?         @unique
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bulkOrderId    String?         @unique // set instead of orderId for a shop-to-shop bulk order
  bulkOrder      BulkOrder?      @relation(fields: [bulkOrderId], references: [id], onDelete: Cascade)
  shopId         String
  shop           Shop            @relation(fields: [shopId], references: [id])
  baseAmount     Int // amount commission is charged on (items after coupon)
  rateBps        Int
  amount         Int
  shopEarning    Int
  settlementId   String?
  settlement     ShopSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  /// Dealer share of the platform commission (amount), fixed when the order is delivered.
  dealerId       String?
  dealer         Dealer?         @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  dealerAmount   Int             @default(0)
  dealerPayoutId String?
  dealerPayout   DealerPayout?   @relation(fields: [dealerPayoutId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@index([shopId, createdAt])
  @@index([settlementId])
  @@index([dealerId, dealerPayoutId])
}

model ShopSettlement {
  id                 String           @id @default(cuid())
  shopId             String
  shop               Shop             @relation(fields: [shopId], references: [id])
  periodStart        DateTime
  periodEnd          DateTime
  orderCount         Int
  grossSales         Int
  commissionAmount   Int
  netPayable         Int
  status             SettlementStatus @default(PENDING)
  requestedBy        String? // "SHOP" (owner payout request) or "ADMIN"
  requestedById      String? // user id
  bankSnapshot       Json? // payout account at request time (account number masked)
  reference          String? // bank UTR / transaction id
  payoutMethod       String? // IMPS / NEFT / RTGS / UPI / OTHER
  proofUrl           String? // receipt screenshot uploaded by admin
  notes              String?
  rejectionReason    String?
  dealerId           String? // dealer who reviews / reviewed this payout
  dealerReviewedAt   DateTime?
  dealerReviewedById String?
  dealerNote         String?
  paidAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  commissions Commission[]

  @@index([shopId, periodStart])
  @@index([shopId, status])
}

/// Where a shop wants its payouts sent. The account number is AES-256-GCM encrypted at rest.
model ShopBankAccount {
  id                String   @id @default(cuid())
  shopId            String   @unique
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  accountHolderName String
  accountNumberEnc  String
  accountLast4      String
  ifsc              String
  bankName          String?
  upiId             String?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ───────────────────────────── Engagement & support ─────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  /// The customer's rating of the Dukaan rider who delivered the order (rider deliveries only).
  riderId       String?
  rider         Rider?   @relation(fields: [riderId], references: [id], onDelete: SetNull)
  riderRating   Int?
  riderComment  String?
  createdAt  DateTime @default(now())

  @@index([shopId])
  @@index([riderId, createdAt])
}

model SupportTicket {
  id           String       @id @default(cuid())
  ticketNumber String       @unique
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  category     String // ORDER | PAYMENT | DELIVERY | REFUND | OTHER
  subject      String
  message      String
  status       TicketStatus @default(OPEN)
  resolution   String?
  resolvedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
}

// ───────────────────────────── Platform ─────────────────────────────

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  bgColor   String    @default("#0f766e")
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ServiceArea {
  id         String   @id @default(cuid())
  city       String
  state      String
  pincodes   String[]
  /// [{ name, lat, lng, pincode }] — selectable areas for manual location selection
  localities Json     @default("[]")
  centerLat  Float?
  centerLng  Float?
  radiusKm   Float?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  /// One dealer per region; a dealer can cover several regions.
  dealerId String?
  dealer   Dealer? @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  riders   Rider[]

  // A city can hold several areas (e.g. one per dealer pincode), so city + state is not unique.
  @@index([city, state])
  @@index([dealerId])
}

model IdempotencyKey {
  key        String   @id
  userId     String
  scope      String
  response   Json?
  statusCode Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String // CASHFREE | SHIPROCKET
  eventId        String
  eventType      String
  payload        Json
  signatureValid Boolean
  processedAt    DateTime?
  error          String?
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([provider, createdAt])
}

// ───────────────────────────── Dealers ─────────────────────────────

/// Regional dealer: onboards shops in their regions, reviews payout requests from those shops before
/// they reach the admin, and earns a share of the platform commission on delivered orders.
model Dealer {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissionShareBps Int      @default(2000) // share of the platform commission, e.g. 2000 = 20%
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  regions     ServiceArea[]
  shops       Shop[]
  riders      Rider[]
  commissions Commission[]
  payouts     DealerPayout[]
  bankAccount DealerBankAccount?
}

/// Dealer asks for their commission share to be paid; the admin transfers it and records the UTR.
model DealerPayout {
  id              String           @id @default(cuid())
  dealerId        String
  dealer          Dealer           @relation(fields: [dealerId], references: [id])
  orderCount      Int
  amount          Int
  status          SettlementStatus @default(PENDING)
  requestedById   String?
  bankSnapshot    Json?
  reference       String?
  payoutMethod    String?
  proofUrl        String?
  notes           String?
  rejectionReason String?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  commissions Commission[]

  @@index([dealerId, status])
}

/// Where a dealer wants payouts sent. The account number is AES-256-GCM encrypted at rest.
model DealerBankAccount {
  id                String   @id @default(cuid())
  dealerId          String   @unique
  dealer            Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  accountHolderName String
  accountNumberEnc  String
  accountLast4      String
  ifsc              String
  bankName          String?
  upiId             String?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ───────────────────────────── Riders ─────────────────────────────

/// Delivery rider, onboarded by a regional dealer. Works in the Dukaan Rider app.
model Rider {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealerId         String?
  dealer           Dealer?        @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  vehicleType      String? // BIKE | SCOOTER | CYCLE | OTHER
  vehicleNumber    String?
  /// Area the rider works in (chosen at signup); its dealer reviews the rider.
  serviceAreaId    String?
  serviceArea      ServiceArea?   @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  kycStatus        RiderKycStatus @default(NOT_SUBMITTED)
  aadhaarNumberEnc String? // AES-256-GCM; only the last 4 digits are ever shown
  aadhaarLast4     String?
  licenseNumber    String?
  /// Private document references (Cloudinary authenticated assets or local dev files) — never public URLs.
  aadhaarFrontRef  String?
  aadhaarBackRef   String?
  licenseRef       String?
  rcRef            String?
  kycSubmittedAt   DateTime?
  kycReviewedAt    DateTime?
  kycReviewedById  String?
  kycNote          String? // rejection reason shown to the rider
  isOnline         Boolean        @default(false)
  lat              Float?
  lng              Float?
  locationAt       DateTime?
  /// Average customer rating (1–5) and how many ratings it is based on.
  rating           Float          @default(0)
  ratingCount      Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  deliveries  Shipment[]
  reviews     Review[]
  wallet      RiderWalletEntry[]
  withdrawals RiderWithdrawal[]
  bankAccount RiderBankAccount?
  badges      Badge[]

  @@index([isOnline])
  @@index([dealerId])
  @@index([kycStatus])
}

/// Rider wallet ledger. Balance = sum(amount). Each delivery adds its fee once (unique per order and type).
model RiderWalletEntry {
  id           String          @id @default(cuid())
  riderId      String
  rider        Rider           @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type         WalletEntryType
  amount       Int // signed, paise
  orderId      String?
  withdrawalId String?
  note         String?
  createdAt    DateTime        @default(now())

  @@unique([orderId, type])
  @@index([riderId, createdAt])
}

/// Rider asks to withdraw wallet money: dealer approves (DEALER_REVIEW → PENDING), admin transfers (PAID).
model RiderWithdrawal {
  id                 String           @id @default(cuid())
  riderId            String
  rider              Rider            @relation(fields: [riderId], references: [id])
  amount             Int
  status             SettlementStatus @default(DEALER_REVIEW)
  bankSnapshot       Json?
  dealerId           String?
  dealerReviewedAt   DateTime?
  dealerReviewedById String?
  dealerNote         String?
  reference          String?
  payoutMethod       String?
  proofUrl           String?
  notes              String?
  rejectionReason    String?
  paidAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([riderId, status])
  @@index([dealerId, status])
}

/// Where a rider wants withdrawals sent. The account number is AES-256-GCM encrypted at rest.
model RiderBankAccount {
  id                String   @id @default(cuid())
  riderId           String   @unique
  rider             Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  accountHolderName String
  accountNumberEnc  String
  accountLast4      String
  ifsc              String
  bankName          String?
  upiId             String?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Monthly "star" badge: the top-scoring shop in each shop category and the top rider in each area.
/// `period` is the IST month it was earned for (e.g. "2026-11"); the winner shows the star during the next month.
model Badge {
  id           String    @id @default(cuid())
  kind         BadgeKind
  period       String
  categoryKey  String // shop: categoryId or "none"; rider: serviceAreaId or "none"
  categoryName String
  shopId       String?
  shop         Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  riderId      String?
  rider        Rider?    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  score        Float
  stats        Json
  createdAt    DateTime  @default(now())

  @@unique([kind, period, categoryKey])
  @@index([shopId])
  @@index([riderId])
  @@index([period])
}

enum AgreementStatus {
  PENDING
  ACCEPTED
  VOID
}

/// The seller agreement emailed to a shop owner at onboarding. `terms` is a frozen snapshot of what they sign;
/// the owner opens the emailed link, confirms with a code sent to the same email, and the shop goes live.
model ShopAgreement {
  id                String          @id @default(cuid())
  shopId            String
  shop              Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  number            String          @unique // e.g. AGR-2026-7KQ2MX
  status            AgreementStatus @default(PENDING)
  tokenHash         String          @unique
  sentTo            String
  sentAt            DateTime        @default(now())
  terms             Json
  acceptedAt        DateTime?
  acceptedName      String?
  acceptedIp        String?
  acceptedUserAgent String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([shopId, status])
}

enum BulkOrderStatus {
  PAYMENT_PENDING // online payment not completed yet
  PLACED // waiting for the seller to accept
  ACCEPTED // seller accepted; stock reserved
  DISPATCHED // seller sent it out
  READY_FOR_PICKUP // buyer can collect
  DELIVERED // handed over (delivered or picked up)
  REJECTED // seller declined
  CANCELLED // buyer cancelled before acceptance, seller couldn't fulfil, or payment expired
}

enum BulkFulfilment {
  DELIVERY
  PICKUP
}

enum BulkPayment {
  ONLINE
  ON_DELIVERY
}

/// A shop buying in bulk from another (wholesaler) shop. Money: online payments are collected by the
/// platform and paid to the seller via payouts; on-delivery payments go to the seller directly, and the
/// platform's B2B commission is deducted from the seller's balance.
model BulkOrder {
  id               String          @id @default(cuid())
  number           String          @unique
  buyerShopId      String
  buyerShop        Shop            @relation("BulkBuyer", fields: [buyerShopId], references: [id])
  sellerShopId     String
  sellerShop       Shop            @relation("BulkSeller", fields: [sellerShopId], references: [id])
  status           BulkOrderStatus
  fulfilment       BulkFulfilment
  paymentMethod    BulkPayment
  paymentStatus    PaymentStatus   @default(PENDING)
  itemCount        Int
  subtotal         Int
  deliveryFee      Int             @default(0)
  total            Int
  note             String?
  buyerAddress     Json // snapshot of the buyer shop's address and contact
  placedById       String
  rejectReason     String?
  cancelledBy      String? // BUYER | SELLER | SYSTEM
  gatewayOrderId   String?         @unique
  gatewayPaymentId String?
  paidAt           DateTime?
  refundId         String?         @unique
  refundStatus     String? // PENDING | SUCCESS | FAILED
  acceptedAt       DateTime?
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items      BulkOrderItem[]
  commission Commission?

  @@index([buyerShopId, createdAt])
  @@index([sellerShopId, status])
  @@index([status, createdAt])
}

model BulkOrderItem {
  id          String        @id @default(cuid())
  bulkOrderId String
  bulkOrder   BulkOrder     @relation(fields: [bulkOrderId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   ShopInventory @relation(fields: [inventoryId], references: [id])
  productName String
  variantName String?
  unitLabel   String?
  imageUrl    String?
  quantity    Int
  unitPrice   Int
  lineTotal   Int

  @@index([bulkOrderId])
}
