# ───────── Core ─────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dukaan?schema=public"
# Used only by integration tests (will be migrated + truncated)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dukaan_test?schema=public"
# Public base URL of the app (used for webhooks / redirects)
APP_URL="http://localhost:3000"
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
SESSION_TTL_HOURS=168

# ───────── Cashfree Payment Gateway (leave blank → in-app sandbox mock) ─────────
# Dashboard → Developers → API Keys. Test keys work with CASHFREE_ENV=sandbox; live keys need production.
# The secret key also verifies webhook signatures (no separate webhook secret).
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox"

# ───────── Shiprocket (leave blank → sandbox mock adapter) ─────────
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_BASE_URL="https://apiv2.shiprocket.in/v1/external"
# Shared secret configured in Shiprocket webhook settings (sent as x-api-key header)
SHIPROCKET_WEBHOOK_TOKEN=""
SHIPROCKET_CHANNEL_ID=""

# ───────── Google Maps (blank → haversine distance fallback) ─────────
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ───────── Firebase Cloud Messaging (blank → in-app + SSE only) ─────────
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
NEXT_PUBLIC_FIREBASE_CONFIG=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ───────── SMS OTP (blank → OTP printed to server log, and shown in UI in development) ─────────
SMS_PROVIDER=""          # msg91 | twilio
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_TEMPLATE_ID=""

# ───────── Image storage (blank → local disk under public/uploads) ─────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ───────── Cron (Vercel Cron sends Authorization: Bearer $CRON_SECRET) ─────────
CRON_SECRET=""

# ───────── Production toggles ─────────
# Max DB connections per app instance (small Azure tiers allow ~50 in total)
DB_POOL_MAX=5
# Run `prisma migrate deploy` when the container starts
RUN_MIGRATIONS=true
# PILOT ONLY: show OTPs on screen in production when no SMS provider is set (anyone can log in as any number!)
OTP_SANDBOX_IN_PRODUCTION=false
# Allow uploads to the container disk in production (files are lost on restart — use Cloudinary instead)
ALLOW_LOCAL_UPLOADS=false
